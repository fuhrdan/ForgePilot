{
  "goal": "Create and verify a tiny Node.js program that prints Hello from ForgePilot v0.3.",
  "planner": "scripted",
  "workspace": "./hello-workspace",
  "actions": [
    {
      "type": "write_file",
      "path": "hello.js",
      "content": "console.log(\"Hello from ForgePilot v0.3\");\n"
    },
    {
      "type": "run_command",
      "command": "node",
      "args": ["hello.js"],
      "expectExitCode": 0
    }
  ],
  "verify": [
    { "type": "file_exists", "path": "hello.js" },
    { "type": "file_contains", "path": "hello.js", "text": "Hello from ForgePilot v0.3" },
    {
      "type": "command",
      "command": "node",
      "args": ["hello.js"],
      "expectExitCode": 0,
      "stdoutIncludes": "Hello from ForgePilot v0.3"
    }
  ]
}
